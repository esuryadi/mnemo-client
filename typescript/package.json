{
  "name": "@panaxon/mnemo-client",
  "version": "1.1.0",
  "description": "TypeScript client for the MNEMO API, the multi-tenant AI memory service from Panaxon AI",
  "license": "Apache-2.0",
  "author": "PANAXON.AI, LLC",
  "homepage": "https://github.com/esuryadi/mnemo-client/tree/main/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esuryadi/mnemo-client.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/esuryadi/mnemo-client/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "embed",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-embed.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test && npm run typecheck"
  },
  "keywords": [
    "mnemo",
    "panaxon",
    "memory",
    "rag",
    "llm"
  ],
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
